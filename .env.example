SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_REGISTRATION=true
REGISTER_RATE_LIMIT_PER_IP=3/minute;10/hour
REGISTER_RATE_LIMIT_GLOBAL=60/hour
# Set to true when serving the frontend over HTTPS.
COOKIE_SECURE=false


FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME_admin_password

POSTGRES_USER=deepref
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=deepref

MINIO_ROOT_USER=deepref-root
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password
MINIO_ACCESS_KEY=deepref-app
MINIO_SECRET_KEY=CHANGE_ME_minio_app_secret
MINIO_BUCKET=deepref

LLM_HF_REPO=HuggingFaceTB/SmolLM2-1.7B-Instruct-GGUF
LLM_HF_FILE=smollm2-1.7b-instruct-q4_k_m.gguf
LLM_CTX_SIZE=8192
LLM_PARALLEL=2
LLM_THREADS=4
LLM_CACHE_RAM_MB=512
LLM_MEM_LIMIT=5g
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
